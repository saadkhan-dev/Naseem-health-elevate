# ---------------------------------------------------------------------------
# Environment template — copy to `.env` and fill in your own values.
# NEVER commit the real `.env`. The same values (names) must be set on the
# deployed Cloudflare worker/periodic task for them to reach production.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# --- SMS / WhatsApp (Twilio) ------------------------------------------------
# Required for SMS. Create/activate a Twilio number ("From"), keep your
# Account SID + Auth Token (Twilio console -> Account -> API keys & tokens).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# Required for WhatsApp. Must be the full WhatsApp sender Twilio gives you,
# e.g. whatsapp:+14155238886, after enabling a sender under Messaging ->
# WhatsApp Senders.
TWILIO_WHATSAPP_FROM=

# Optional but recommended for WhatsApp: approved content-template SIDs so
# outbound messages meet Twilio's out-of-session template requirement. Create
# the templates in the Twilio console and reference their SIDs here. Template
# placeholders must match: {{1}} Appointment ID, {{2}} Patient name,
# {{3}} Service, {{4}} Date, {{5}} Time, {{6}} Status URL (video adds
# {{6}} Video ID, {{7}} Join link). When a SID is absent the sender falls back
# to a free-form Body (only works inside a 24-hour session with the sender).
TWILIO_WHATSAPP_CONTENT_SID_APPOINTMENT=
TWILIO_WHATSAPP_CONTENT_SID_STATUS=
TWILIO_WHATSAPP_CONTENT_SID_RESCHEDULE=
TWILIO_WHATSAPP_CONTENT_SID_VIDEO=

# Dial prefix used to normalize phone numbers the patient enters without a
# country code (e.g. "03152968384" -> "+923152968384"). 
PHONE_COUNTRY_CODE=+92

# --- WhatsApp Cloud API (Meta, server-only) ----------------------------------
# Second, independent WhatsApp path (the Twilio sender above stays untouched).
# These are read ONLY on the server — never prefix them with VITE_ or they will
# be baked into the client bundle. On Cloudflare set them with
# `npx wrangler secret put <NAME>`.
#
# Callback URL for Meta Developers -> WhatsApp -> Configuration -> Webhooks:
#   <SITE_URL>/webhooks/meta/whatsapp
# (Meta calls it with GET to verify, then POST for every event.)

# App Secret from Developers -> App Settings -> Basic. Used to verify the
# X-Hub-Signature-256 header on inbound events. This is NOT the access token.
META_WA_APP_SECRET=

# Any random string you choose (e.g. openssl rand -hex 32). Paste the SAME value
# into Meta's "Verify token" field; Meta echoes it back on the GET handshake.
META_WA_VERIFY_TOKEN=

# Permanent-system-user token from the Meta Business Portfolio -> WhatsApp
# Manager -> API Setup. Used later for sending; the webhook does not call it.
META_WA_ACCESS_TOKEN=

# WhatsApp Manager -> API Setup -> "Phone number ID" and "WhatsApp Business
# Account ID" (the WABA id, not a Facebook Page id).
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=

# Optional Graph API version override; defaults to v23.0 when blank.
META_WA_API_VERSION=

# --- Meta WhatsApp OUTBOUND (server-only) ------------------------------------
# Which provider sends outbound WhatsApp. Leave this UNSET (or "twilio") to keep
# the current Twilio behaviour exactly as it is today. Set it to "meta" ONLY
# after the Meta credentials and approved templates below are configured.
# Any other/unknown value falls back to "twilio" so a typo can never silently
# disable WhatsApp in production.
#   twilio -> POST api.twilio.com/.../Messages.json   (default, unchanged)
#   meta   -> POST graph.facebook.com/{version}/{META_WA_PHONE_NUMBER_ID}/messages
# This setting does NOT affect SMS, email or in-app notifications.
WHATSAPP_PROVIDER=

# Approved Meta template NAMES, copied exactly from WhatsApp Manager ->
# Message Templates. Do not invent them and do not add the {{1}}..{{n}}
# placeholders here. Meta rejects a send when the number of body parameters
# does not match the approved template, so the order below is load-bearing.
#
# The value of each variable is the template name sent on the wire. Renaming or
# re-approving a template in WhatsApp Manager only means updating these values —
# no code change. The variable NAMES are stable internal identifiers and are
# deliberately not the Meta template names.
#
# Currently ACTIVE names and their exact placeholders (language `en`):
#
#   META_WA_TEMPLATE_APPOINTMENT_CONFIRMATION = appointment_confirmed
#       ({{1}} name, {{2}} date, {{3}} time, {{4}} appointment ID,
#        {{5}} service)                                           -> 5 params
#   META_WA_TEMPLATE_APPOINTMENT_RESCHEDULED  = appointment_schedule_changed
#       ({{1}} name, {{2}} new date, {{3}} new time, {{4}} appointment ID,
#        {{5}} service)                                           -> 5 params
#   META_WA_TEMPLATE_APPOINTMENT_CANCELLED    = appointment_cancelled_notice
#       ({{1}} name, {{2}} date, {{3}} time, {{4}} appointment ID,
#        {{5}} service)                                           -> 5 params
#   META_WA_TEMPLATE_APPOINTMENT_REMINDER     = appointment_reminder_notice_category_utility
#       ({{1}} name, {{2}} date, {{3}} time, {{4}} appointment ID,
#        {{5}} service)                                           -> 5 params
#   META_WA_TEMPLATE_VIDEO_CONSULTATION_READY  = video_consultation_ready_notice
#       ({{1}} name, {{2}} date, {{3}} time, {{4}} appointment ID)
#                                                      -> 4 params, NO join-link variable
#   META_WA_TEMPLATE_PAYMENT_RECEIVED          = payment_received_notice
#       ({{1}} name, {{2}} appointment ID, {{3}} amount, {{4}} payment status,
#        {{5}} service)                                           -> 5 params
#   META_WA_TEMPLATE_APPOINTMENT_PAYMENT_PENDING = appointment_payment_pending_notice
#       ({{1}} name, {{2}} appointment ID, {{3}} amount due,
#        {{4}} payment status)                                    -> 4 params
#   META_WA_TEMPLATE_APPOINTMENT_REFUND        = refund_processed_assalamu_alaikum_1_...
#       ({{1}} name, {{2}} appointment ID, {{3}} refund amount,
#        {{4}} refund status)                                     -> 4 params
#   META_WA_TEMPLATE_ORDER_CONFIRMATION        = order_confirmed_notice
#       ({{1}} name, {{2}} order ID, {{3}} order date,
#        {{4}} total amount)                                      -> 4 params
#   META_WA_TEMPLATE_ORDER_STATUS_UPDATE       = order_status_update_notice
#       ({{1}} name, {{2}} order ID, {{3}} order status)          -> 3 params
#   META_WA_TEMPLATE_ORDER_PAYMENT_CONFIRMED   = order_payment_confirmed
#       ({{1}} name, {{2}} order ID, {{3}} amount paid,
#        {{4}} payment status)                                    -> 4 params
#   META_WA_TEMPLATE_ORDER_PAYMENT_PENDING     = order_payment_pending_notice
#       ({{1}} name, {{2}} order ID, {{3}} amount due,
#        {{4}} payment status)                                    -> 4 params
#   META_WA_TEMPLATE_ORDER_REFUND              = order_refund_notice
#       ({{1}} name, {{2}} order ID, {{3}} refund amount,
#        {{4}} refund status)                                     -> 4 params
#
# META_WA_TEMPLATE_APPOINTMENT_REFUND holds the exact approved Meta name, which
# Meta generated from the message body and is therefore a long underscore-
# separated string. It must be copied from WhatsApp Manager character-for-
# character: never shortened, sanitized, camel-cased or re-typed, or Meta
# rejects the send. The full value is on the assignment line below.
#
# Meta's `hello_world` sample template is intentionally not represented here and
# is never used by the clinic notification flow.
#
# No approved template carries the appointment status URL, the video join link
# or the previous date/time, so those values are never sent.
#
# There is NO generic "status" template. Appointment status changes use
# META_WA_TEMPLATE_APPOINTMENT_CANCELLED for `cancelled` only; every other
# status reports `not_configured` on WhatsApp rather than inventing a template.
#
# NOTE: order notifications are still delivered over SMS + email only (existing
# product policy). The META_WA_TEMPLATE_ORDER_* and the appointment
# payment/refund templates are mapped and ready, but the application has no
# patient-facing outbound sender for appointment payment/refund yet, so those
# are not reached. Support replies are also SMS + email only.
META_WA_TEMPLATE_APPOINTMENT_CONFIRMATION=appointment_confirmed
META_WA_TEMPLATE_APPOINTMENT_RESCHEDULED=appointment_schedule_changed
META_WA_TEMPLATE_APPOINTMENT_CANCELLED=appointment_cancelled_notice
META_WA_TEMPLATE_APPOINTMENT_REMINDER=appointment_reminder_notice_category_utility
META_WA_TEMPLATE_VIDEO_CONSULTATION_READY=video_consultation_ready_notice
META_WA_TEMPLATE_PAYMENT_RECEIVED=payment_received_notice
META_WA_TEMPLATE_APPOINTMENT_PAYMENT_PENDING=appointment_payment_pending_notice
META_WA_TEMPLATE_APPOINTMENT_REFUND=refund_processed_assalamu_alaikum_1_your_refund_has_been_processed_successfully_refund_details__appointment_id_2__refund_amount_3__refund_status_4_the_refunded_amount_will_be_returned_according_to_your_payment_providers_processing_time_if_you_have_any_questions_about_your_refund_please_contact_us_thank_you_for_choosing_rahat_homeopathic__physiotherapy_clinic
META_WA_TEMPLATE_ORDER_CONFIRMATION=order_confirmed_notice
META_WA_TEMPLATE_ORDER_STATUS_UPDATE=order_status_update_notice
META_WA_TEMPLATE_ORDER_PAYMENT_CONFIRMED=order_payment_confirmed
META_WA_TEMPLATE_ORDER_PAYMENT_PENDING=order_payment_pending_notice
META_WA_TEMPLATE_ORDER_REFUND=order_refund_notice

# `template.language.code` sent to Meta. It must match the approved template's
# language exactly. Meta's supported-languages table lists plain "English" as
# `en`, and "English (US)" as `en_US` — these templates show plain "English",
# so the default below is `en`. META_WA_TEMPLATE_LANGUAGE_CODE is canonical;
# META_WA_TEMPLATE_LANGUAGE is an accepted alias with lower precedence. Set
# this explicitly if your dashboard shows a locale-qualified language. A
# malformed value is ignored rather than sent (Meta would reject the message).
META_WA_TEMPLATE_LANGUAGE_CODE=en
META_WA_TEMPLATE_LANGUAGE=

# --- Video consultations (LiveKit, server-only) ------------------------------
# LiveKit Cloud project. Required to actually start calls; the flow still works
# (with an honest "not configured" notice) without them. Get these from
# https://cloud.livekit.io -> your project -> Settings -> Keys.
# LIVEKIT_URL        wss:// URL of YOUR project (see cloud.livekit.io -> Settings)
# LIVEKIT_API_KEY    project API key
# LIVEKIT_API_SECRET project API secret
# LIVEKIT_PLAN       optional display label for the admin usage panel (Build/Pro)
# IMPORTANT: paste your OWN values. The docs placeholder hostname
# (`your-project.livekit.cloud`) has no project behind it and the app refuses
# to use it. Never commit a real key/secret in this file.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
# LIVEKIT_PLAN=

# --- Real-time voice translation (Azure AI Speech, server-only) ---------------
# Optional: powers the in-call interpreter (patient <-> Urdu). The browser only
# ever receives a short-lived token minted server-side, never the key.
# Create a Speech resource at https://portal.azure.com -> AI + Machine Learning
# -> Speech (S0 tier), then copy its key + region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Gemini / Elfsight ------------------------------------------------------
GEMINI_API_KEY=

# --- Google Reviews widget (Elfsight) ------------------------------------------
# Public Google reviews are rendered by the Elfsight Google Reviews widget
# (https://elfsightcdn.com/platform.js). No Google Places API key is used
# anywhere in this project. The widget's app id is already built in
# (ELFSIGHT_GOOGLE_REVIEWS_APP_ID in src/lib/elfsight.ts), so leave this empty
# unless you swap in a different Elfsight app. The value ships in public install
# code, so it is not a secret and needs no server-side handling.
VITE_ELFSIGHT_GOOGLE_REVIEWS_APP_ID=

# --- Public site URL (used for patient-facing links in notifications) --------
SITE_URL=